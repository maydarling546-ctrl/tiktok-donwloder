    <!-- JavaScript Logic -->
    <script>
        // Store API and App States
        let currentVideoData = null;

        // On Load Initialize
        document.addEventListener('DOMContentLoaded', () => {
            renderHistory();
        });

        // Switch Tabs (Downloader / History)
        function switchTab(tab) {
            const secDownloader = document.getElementById('section-downloader');
            const secHistory = document.getElementById('section-history');
            const btnDownloader = document.getElementById('tab-btn-downloader');
            const btnHistory = document.getElementById('tab-btn-history');

            if (tab === 'downloader') {
                secDownloader.classList.remove('hidden');
                secHistory.classList.add('hidden');
                btnDownloader.className = "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-slate-800 text-cyan-400 border border-slate-700/50";
                btnHistory.className = "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 text-slate-400 hover:text-slate-200 hover:bg-slate-800/50";
            } else {
                secDownloader.classList.add('hidden');
                secHistory.classList.remove('hidden');
                btnHistory.className = "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-slate-800 text-cyan-400 border border-slate-700/50";
                btnDownloader.className = "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 text-slate-400 hover:text-slate-200 hover:bg-slate-800/50";
                renderHistory();
            }
        }

        // Reset App UI
        function resetApp() {
            document.getElementById('tiktok-url').value = '';
            document.getElementById('result-state').classList.add('hidden');
            document.getElementById('loading-state').classList.add('hidden');
            switchTab('downloader');
        }

        // Paste URL from Clipboard
        async function pasteClipboard() {
            try {
                const text = await navigator.clipboard.readText();
                if (text) {
                    document.getElementById('tiktok-url').value = text;
                    showToast('Berhasil menempel tautan!', 'success');
                } else {
                    showToast('Clipboard kosong', 'warning');
                }
            } catch (err) {
                showToast('Gagal mengakses clipboard. Silakan tempel secara manual.', 'error');
            }
        }

        // Format Number (e.g., 1000 -> 1k)
        function formatNumber(num) {
            if (!num) return '0';
            if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
            if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
            return num.toString();
        }

        // Handle Fetch Video Form Submission
        async function handleFetchVideo(e) {
            e.preventDefault();
            const inputUrl = document.getElementById('tiktok-url').value.trim();

            if (!inputUrl) {
                showToast('Harap masukkan URL TikTok terlebih dahulu', 'warning');
                return;
            }

            // Simple URL Validation
            if (!inputUrl.includes('tiktok.com')) {
                showToast('URL yang dimasukkan tampaknya bukan tautan TikTok yang valid', 'error');
                return;
            }

            // Set UI Loading State
            setLoading(true);
            document.getElementById('result-state').classList.add('hidden');

            try {
                // Fetching via Tikwm API (CORS friendly endpoint)
                const response = await fetch(`https://www.tikwm.com/api/?url=${encodeURIComponent(inputUrl)}`);
                const result = await response.json();

                if (result.code === 0 && result.data) {
                    const data = result.data;
                    currentVideoData = {
                        id: data.id,
                        title: data.title || 'TikTok Video',
                        authorName: data.author.nickname || 'TikTok User',
                        authorUnique: data.author.unique_id || 'user',
                        avatar: data.author.avatar,
                        cover: data.cover,
                        playNoWm: data.play,
                        playHd: data.hdplay || data.play,
                        music: data.music,
                        likes: data.digg_count,
                        comments: data.comment_count,
                        shares: data.share_count,
                        timestamp: new Date().getTime()
                    };

                    displayResult(currentVideoData);
                    saveToHistory(currentVideoData);
                    showToast('Video berhasil dimuat!', 'success');
                } else {
                    showToast(result.msg || 'Gagal mengambil data video. Pastikan akun tidak privat.', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Terjadi kesalahan jaringan/server. Coba lagi nanti.', 'error');
            } finally {
                setLoading(false);
            }
        }

        // UI Loading Indicator Toggle
        function setLoading(isLoading) {
            const btnSubmit = document.getElementById('btn-submit');
            const btnIcon = document.getElementById('btn-icon');
            const btnText = document.getElementById('btn-text');
            const loadingState = document.getElementById('loading-state');

            if (isLoading) {
                btnSubmit.disabled = true;
                btnIcon.className = "ri-loader-4-line text-lg animate-spin";
                btnText.innerText = "Memproses...";
                loadingState.classList.remove('hidden');
            } else {
                btnSubmit.disabled = false;
                btnIcon.className = "ri-search-line text-lg";
                btnText.innerText = "Proses";
                loadingState.classList.add('hidden');
            }
        }

        // Render Result Card
        function displayResult(data) {
            const resultState = document.getElementById('result-state');
            const videoPreview = document.getElementById('video-preview');

            document.getElementById('author-avatar').src = data.avatar || 'https://placehold.co/100x100/1e293b/f8fafc?text=User';
            document.getElementById('author-name').innerText = data.authorName;
            document.getElementById('author-unique').innerText = `@${data.authorUnique}`;
            document.getElementById('video-title').innerText = data.title;
            
            document.getElementById('stat-likes').innerText = formatNumber(data.likes);
            document.getElementById('stat-comments').innerText = formatNumber(data.comments);
            document.getElementById('stat-shares').innerText = formatNumber(data.shares);

            // Set Video Source
            videoPreview.src = data.playNoWm;
            videoPreview.poster = data.cover;

            // Set Download Links
            const btnNoWm = document.getElementById('btn-dl-nowm');
            const btnHd = document.getElementById('btn-dl-hd');
            const btnMusic = document.getElementById('btn-dl-music');

            btnNoWm.href = data.playNoWm;
            btnHd.href = data.playHd;
            btnMusic.href = data.music;

            resultState.classList.remove('hidden');
            resultState.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // LOCALSTORAGE HISTORY MANAGMENT
        function getHistory() {
            try {
                return JSON.parse(localStorage.getItem('tiksave_history')) || [];
            } catch (e) {
                return [];
            }
        }

        function saveToHistory(item) {
            let history = getHistory();
            // Filter duplicate items
            history = history.filter(h => h.id !== item.id);
            // Prepend new item
            history.unshift(item);
            // Limit to max 20 items
            if (history.length > 20) history.pop();
            localStorage.setItem('tiksave_history', JSON.stringify(history));
            updateHistoryBadge();
        }

        function clearHistory() {
            if (confirm('Apakah Anda yakin ingin menghapus semua riwayat unduhan?')) {
                localStorage.removeItem('tiksave_history');
                renderHistory();
                showToast('Riwayat berhasil dihapus', 'success');
            }
        }

        function updateHistoryBadge() {
            const count = getHistory().length;
            document.getElementById('history-badge').innerText = count;
        }

        function renderHistory() {
            const history = getHistory();
            const container = document.getElementById('history-list');
            const emptyState = document.getElementById('empty-history');
            const btnClear = document.getElementById('btn-clear-history');

            updateHistoryBadge();

            if (history.length === 0) {
                container.innerHTML = '';
                emptyState.classList.remove('hidden');
                btnClear.classList.add('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            btnClear.classList.remove('hidden');

            container.innerHTML = history.map(item => `
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex gap-3 items-center hover:border-slate-700 transition-colors group">
                    <img src="${item.cover}" alt="Thumbnail" class="w-16 h-20 object-cover rounded-lg bg-slate-950 flex-shrink-0">
                    <div class="flex-grow min-w-0 space-y-1">
                        <p class="text-xs font-semibold text-cyan-400 truncate">@${item.authorUnique}</p>
                        <p class="text-xs text-slate-300 line-clamp-2 leading-snug">${item.title}</p>
                        <div class="flex items-center gap-2 pt-1">
                            <a href="${item.playNoWm}" target="_blank" download class="text-[11px] bg-slate-800 hover:bg-slate-700 text-slate-200 px-2 py-1 rounded flex items-center gap-1 transition-colors">
                                <i class="ri-download-line text-cyan-400"></i> MP4
                            </a>
                            <a href="${item.music}" target="_blank" download class="text-[11px] bg-slate-800 hover:bg-slate-700 text-slate-200 px-2 py-1 rounded flex items-center gap-1 transition-colors">
                                <i class="ri-music-line text-pink-400"></i> MP3
                            </a>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // TOAST SYSTEM
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let bgBorder = 'bg-slate-900 border-slate-700 text-slate-200';
            let icon = 'ri-information-fill text-cyan-400';

            if (type === 'success') {
                bgBorder = 'bg-slate-900 border-emerald-500/50 text-emerald-200';
                icon = 'ri-checkbox-circle-fill text-emerald-400';
            } else if (type === 'error') {
                bgBorder = 'bg-slate-900 border-red-500/50 text-red-200';
                icon = 'ri-error-warning-fill text-red-400';
            } else if (type === 'warning') {
                bgBorder = 'bg-slate-900 border-amber-500/50 text-amber-200';
                icon = 'ri-alert-fill text-amber-400';
            }

            toast.className = `flex items-center gap-3 p-3.5 rounded-xl border shadow-xl backdrop-blur-md ${bgBorder} transition-all duration-300 transform translate-y-2 opacity-0 text-xs sm:text-sm font-medium`;
            toast.innerHTML = `
                <i class="${icon} text-lg flex-shrink-0"></i>
                <span class="flex-grow">${message}</span>
            `;

            container.appendChild(toast);

            // Animate in
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            // Auto Remove after 3.5s
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => {
                    toast.remove();
                }, 300);
            }, 3500);
        }
    </script>
</body>
</html>
